# Copy these lines into Streamlit Cloud → your app → Settings → Secrets (do NOT commit a real secrets.toml).
# Every line is optional. Without any key the AI assistant runs in its offline mode.

# Platform keys (shared by all users, under the limits below)
# GEMINI_API_KEY = "AIza..."           # free tier available: https://aistudio.google.com/apikey
# GROQ_API_KEY = "gsk_..."             # free plan: https://console.groq.com/keys
# OPENROUTER_API_KEY = "sk-or-..."     # free ':free' models: https://openrouter.ai/keys
# ANTHROPIC_API_KEY = "sk-ant-..."     # paid: https://console.anthropic.com/settings/keys
# OPENAI_API_KEY = "sk-..."            # paid: https://platform.openai.com/api-keys

# Controls for the platform keys
# AETHERIS_AI_ACCESS_CODE = "choose-a-code"   # users must enter it to use the platform keys
# AETHERIS_AI_SESSION_DAILY = 20              # requests per user session per day
# AETHERIS_AI_GLOBAL_DAILY = 300              # requests per day for the whole platform
# AETHERIS_AI_SERVER_ALL_MODELS = "0"         # "1" = allow expensive models with the platform keys
# AETHERIS_AI_DEFAULT_PROVIDER = "gemini"     # provider selected by default
